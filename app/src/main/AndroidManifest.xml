<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Android 17+ (SDK 37): mandatory runtime permission for raw local-network sockets,
         which is exactly how smbj connects to an SMB share. Without it, connections to
         hosts on the local network silently time out instead of being explicitly denied. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- Only needed on API 26-28 to write into the legacy public Downloads dir; API 29+ uses
         MediaStore.Downloads instead, which needs no storage permission. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- LibraryScanWorker runs as a foreground service (via WorkManager's setForeground) while a
         background rescan is in progress, so the OS doesn't defer/kill it under Doze - required
         alongside the generic FOREGROUND_SERVICE permission once a specific type is declared. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- PlaybackService (MediaSessionService) promotes itself to a foreground service while
         something is playing, so the OS shows a real media notification in the shade/lock screen -
         required alongside FOREGROUND_SERVICE once a specific type is declared, same as the scan
         worker's FOREGROUND_SERVICE_DATA_SYNC above. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Needed to launch the system package installer with a downloaded update .apk - without it
         the ACTION_VIEW install intent silently does nothing on API 26+. Granting this doesn't
         skip the OS's own "install unknown apps" confirmation (Settings > Apps > Special access) -
         that's a separate, one-time-per-source gate the user still has to clear themselves; see
         UpdateInstaller's own KDoc. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- The Xiaomi TV Box target has no touchscreen and may not declare the leanback feature -
         both must be optional or the Play Store (and some OEM stores) would filter the app out
         of TV device listings entirely. D-pad/remote navigation is added in ui/* per-screen. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- Android 11+ (API 30+) hides other apps from PackageManager queries by default (package
         visibility) regardless of any runtime permission - without this, InstalledPlayerApps'
         queryIntentActivities call would silently return an empty list on a real device even
         with VLC/MX Player installed, making the external-player picker in Settings look broken. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="video/*" />
        </intent>
        <!-- Same package-visibility gap as above, for DownloadStorage.openFolderIntent()'s
             "Открыть папку" button - queryIntentActivities() for a folder-view ACTION_VIEW
             (vnd.android.document/directory) or DownloadManager.ACTION_VIEW_DOWNLOADS returned
             empty even with a real file manager (built-in MIUI one, Solid Explorer) installed,
             so the code always concluded "no app found" and never even tried startActivity. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="vnd.android.document/directory" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW_DOWNLOADS" />
        </intent>
    </queries>

    <application
        android:name=".IllusionApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Illusion">
        <!-- IllusionApplication supplies a custom WorkerFactory (see Configuration.Provider) - the
             default WorkManager auto-initializer must be removed or it silently wins, leaving
             LibraryScanWorker/DownloadWorker to be built via the no-arg default
             factory, which fails since they take injected dependencies, not a bare constructor. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- WorkManager's own manifest declares this service with no foregroundServiceType, which
             defaults to none (0x0) - LibraryScanWorker's setForeground() call requests
             FOREGROUND_SERVICE_TYPE_DATA_SYNC (0x1), and since targetSdk 34+ the OS fatally
             rejects a requested type that isn't a subset of what the manifest declares
             (IllegalArgumentException: "foregroundServiceType 0x1 is not a subset of ... 0x0"),
             crashing the whole app the moment a scan starts. Must be overridden here to match. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- No LAUNCHER intent-filter of its own anymore - see the activity-alias block below.
             Exactly one alias is enabled at a time (IllusionApplication doesn't manage this;
             see data/appicon/IconVariantManager) and that's what actually shows on the home
             screen; MainActivity itself is only ever reached through whichever alias is active. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Illusion.Splash"
            android:windowSoftInputMode="adjustResize"
            android:supportsPictureInPicture="true"
            android:windowLayoutInDisplayCutoutMode="always"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|uiMode" />

        <!-- Alternate launcher icons (Настройки > Значок приложения) - one alias per AppIcon
             entry, all targeting MainActivity. Exactly one is enabled at install time (Illusion,
             matching the app's existing default appearance unchanged) and IconVariantManager
             flips enabled/disabled between them at runtime - the OS only shows a home-screen icon
             for whichever alias is currently enabled, so this list itself never changes, only the
             android:enabled state does (managed at runtime, not by editing this manifest). -->
        <activity-alias
            android:name=".IconIllusion"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconDefault"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_default"
            android:roundIcon="@mipmap/ic_launcher_default"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconBlue"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_blue"
            android:roundIcon="@mipmap/ic_launcher_blue"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconGreen"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_green"
            android:roundIcon="@mipmap/ic_launcher_green"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconOrange"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_orange"
            android:roundIcon="@mipmap/ic_launcher_orange"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconYellow"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_yellow"
            android:roundIcon="@mipmap/ic_launcher_yellow"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconRed"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_red"
            android:roundIcon="@mipmap/ic_launcher_red"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconTeal"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_teal"
            android:roundIcon="@mipmap/ic_launcher_teal"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconPink"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_pink"
            android:roundIcon="@mipmap/ic_launcher_pink"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Exposes UpdateDownloadWorker's downloaded .apk (context.cacheDir/updates) to the
             system package installer via a content:// Uri - a raw file:// Uri would be rejected
             (StrictMode FileUriExposedException) on API 24+. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".data.player.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Loopback-only HTTP bridge (data/player/StreamingService.kt) that re-serves an SMB
             file as a plain http://127.0.0.1 URL so external video players without their own SMB
             client can play a not-yet-downloaded item at all. -->
        <service
            android:name=".data.player.StreamingService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>

</manifest>