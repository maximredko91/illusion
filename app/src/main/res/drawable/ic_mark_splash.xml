        <path android:fillColor="@color/illusion_crimson" android:pathData="M86,21h6a2,2 0 0 1 2,2v62a2,2 0 0 1 -2,2h-6a2,2 0 0 1 -2,-2V23a2,2 0 0 1 2,-2z"/>
