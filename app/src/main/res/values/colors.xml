<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Фирменные цвета Иллюзион -->
    <color name="illusion_crimson">#FFC2413A</color>
    <color name="illusion_cream">#FFF2E9DC</color>

    <!-- Иконка: фон НЕ зависит от темы, лончер её не переключает -->
    <color name="icon_bg">#FF14100F</color>

    <!-- Альтернативные значки приложения (Настройки > Значок) - каждый цвет совпадает с
         lightPrimary соответствующего AccentColor, тот же принцип, что и у illusion_crimson
         (= AccentColor.ILLUSION.lightPrimary) для текущего значка по умолчанию. -->
    <color name="icon_accent_default">#FF6650A4</color>
    <color name="icon_accent_blue">#FF3F5CA9</color>
    <color name="icon_accent_green">#FF3D6B3E</color>
    <color name="icon_accent_orange">#FFA85400</color>
    <color name="icon_accent_yellow">#FF8C6D00</color>
    <color name="icon_accent_red">#FFA13F3F</color>
    <color name="icon_accent_teal">#FF1C6C68</color>
    <color name="icon_accent_pink">#FFA13D77</color>

    <!-- Фон окна. Его показывает система там, где контент приложения не нарисован: при
         predictive back окно уезжает уменьшенной карточкой, и вокруг неё видно именно его. Без
         явного значения берётся фон родительской темы, а она у нас жёстко светлая
         (android:Theme.Material.Light.NoActionBar), то есть в тёмной теме это была бы ещё и
         светлая вспышка. Точно совпасть с фоном Compose нельзя - там динамические цвета Material
         You, - поэтому берём ту же пару, что и сплешскрин. -->
    <color name="window_bg">#FFF4EDE4</color>

    <!-- Сплешскрин, светлая тема -->
    <color name="splash_bg">#FFF4EDE4</color>
    <color name="illusion_ink_on_bg">#FF1A1512</color>
</resources>