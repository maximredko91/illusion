<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Illusion" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- MainActivity's launch theme only, swapped for Theme.Illusion the moment SplashScreen exits
         (see MainActivity.installSplashScreen() + postSplashScreenTheme below). Design spec
         "Перфорация": the animated mark fades/scales in (splash_icon_anim.xml) against
         splash_bg (day/night variants in values / values-night). No
         windowSplashScreenBrandingImage - vector drawables can't render text, and a rasterized
         wordmark PNG would go soft at higher densities; the spec's own recommendation is to skip
         it here and show "ИЛЛЮЗИОН" as real text on the app's first screen instead if wanted. -->
    <style name="Theme.Illusion.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_anim</item>
        <item name="windowSplashScreenAnimationDuration">500</item>
        <item name="postSplashScreenTheme">@style/Theme.Illusion</item>
    </style>
</resources>